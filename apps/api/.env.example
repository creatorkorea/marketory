# Copy to apps/api/.env. Local values only; never use this password in hosted environments.
MARKETORY_ENVIRONMENT=local
MARKETORY_DATABASE_URL=postgresql://marketory:marketory_local@127.0.0.1:55432/marketory
MARKETORY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MARKETORY_WORKER_POLL_SECONDS=10
# Add these after a real Supabase project is selected. Never commit this local .env.
# MARKETORY_SUPABASE_URL=https://your-project.supabase.co
# MARKETORY_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only; NEVER copy this value to NEXT_PUBLIC_* or apps/web.
# MARKETORY_SUPABASE_SECRET_KEY=your-server-secret-key
MARKETORY_STORAGE_BUCKET=seller-assets
MARKETORY_PUBLIC_API_URL=http://127.0.0.1:8000
MARKETORY_UPLOAD_INTENT_TTL_SECONDS=900
