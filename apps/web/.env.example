# Server-only API origin. Browser uses an allowlisted relay, never DB credentials.
API_BASE_URL=http://127.0.0.1:8000
# Exact browser origin (scheme + hostname + optional port), no trailing slash.
# Set per deployment, including preview environments.
APP_ORIGIN=http://127.0.0.1:3000
# Public SDK configuration exposed by /api/auth/config. Never use a service role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
