{
  "version": "alpha",
  "name": "MARKETORY",
  "description": "마켓 차양과 셀러의 이야기를 담은 여백 중심의 운영 도구",
  "colors": {
    "primary": "#244B3D",
    "primary-hover": "#1B3C30",
    "primary-pressed": "#143025",
    "on-primary": "#FFFFFF",
    "background": "#FCFAF5",
    "surface": "#FFFFFF",
    "surface-subtle": "#F3F1EA",
    "selected": "#E7EFE8",
    "text": "#26332E",
    "text-secondary": "#59665E",
    "border": "#DADFD8",
    "control-border": "#849187",
    "focus": "#356F58",
    "success": "#28573D",
    "success-bg": "#E4EEE2",
    "warning": "#854117",
    "warning-bg": "#FCEAD7",
    "danger": "#9E3042",
    "danger-bg": "#F9E7EA",
    "info": "#35536A",
    "info-bg": "#E8EFF5",
    "neutral": "#53605B",
    "neutral-bg": "#ECEEEA",
    "disabled": "#E4E7E1",
    "disabled-text": "#606961",
    "tag-ceramic": "#EBDDCA",
    "tag-bakery": "#EED5C5",
    "tag-textile": "#DFE3D3",
    "tag-plant": "#DCE8D5"
  },
  "typography": {
    "sans": {
      "fontFamily": "\"Pretendard Variable\", Pretendard, \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif",
      "fontSize": "16px",
      "lineHeight": "1.6"
    }
  },
  "rounded": {
    "DEFAULT": "8px",
    "sm": "4px",
    "lg": "12px",
    "pill": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "section": "48px",
    "page": "64px",
    "page-max": "1440px"
  },
  "components": {
    "button": {
      "height": "44px",
      "rounded": "8px"
    },
    "input": {
      "height": "48px",
      "rounded": "8px"
    },
    "dialog": {
      "width": "480px",
      "rounded": "12px"
    },
    "status-badge": {
      "height": "28px",
      "rounded": "999px"
    },
    "canopy": {
      "height": "8px",
      "width": "16px"
    }
  }
}
